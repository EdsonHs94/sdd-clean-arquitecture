# Copy to .env and supply your own values. Never commit .env.
DATABASE_URL=postgresql+asyncpg://replace-user:replace-password@localhost:5432/replace-database
# Generate a random signing secret, e.g. with secrets.token_urlsafe(32).
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ISSUER=user-architecture-model
JWT_AUDIENCE=user-architecture-model-api
S3_BUCKET=replace-with-private-bucket-name
AWS_REGION=us-east-1
S3_ENDPOINT_URL=
# Optional local Compose host ports; Compose uses its own dummy service credentials.
API_PORT=8000
POSTGRES_PORT=55432
S3_PORT=59000
